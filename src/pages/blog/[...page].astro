---
import Workspace from '../../layouts/Workspace.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ogImage from '../../assets/blog/OG.webp';
import { BLOG } from '../../lib/workspace';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('blog');
  const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const allTags = [...new Set(sortedPosts.flatMap((post) => post.data.tags || []))].sort();
  return paginate(sortedPosts, { pageSize: 10, props: { allTags } });
}) satisfies GetStaticPaths;

const { page, allTags } = Astro.props;
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const file = page.currentPage === 1 ? BLOG : { ...BLOG, name: `blog (${page.currentPage})` };
---

<Workspace
  file={file}
  title="Blog | Naofal Leo Agusta"
  description="Blog posts by Naofal Leo Agusta about front-end engineering, React, Node.js, JavaScript, TypeScript, and more."
  ogImage={ogImage.src}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://naofalleoagusta.xyz' },
      { '@type': 'ListItem', position: 2, name: 'Blog' },
    ],
  }}
>
  <section class="px-4 py-6 text-[0.8125rem] leading-6 sm:px-8">
    <h1 class="sr-only">Blog</h1>
    <p class="text-muted">
      Thoughts, tutorials, and learnings from my journey as a software engineer.
    </p>

    <p class="mt-4"><span class="text-accent">$</span> ls -la blog/</p>
    <p class="text-muted">total {page.total}</p>

    <ul
      id="blog-list"
      class="mt-1 grid grid-cols-[auto_auto_minmax(0,1fr)] gap-x-4 sm:grid-cols-[auto_auto_auto_minmax(0,1fr)] md:grid-cols-[auto_auto_auto_auto_minmax(0,1fr)]"
    >
      {
        page.data.map((post) => (
          <li
            class="contents"
            data-tags={(post.data.tags || []).join(',').toLowerCase()}
            data-title={post.data.title.toLowerCase()}
          >
            <a
              href={`/blog/${post.data.permalink}`}
              class="group col-span-full -mx-2 grid grid-cols-subgrid rounded px-2 py-1 whitespace-nowrap hover:bg-raised"
            >
              <span class="hidden text-faint sm:inline">-rw-r--r--</span>
              <span class="hidden text-muted md:inline">naofal</span>
              <span class="text-right text-syn-num">{post.data.readingTime}</span>
              <time class="text-muted" datetime={post.data.date.toISOString()}>
                {isoDate(post.data.date)}
              </time>
              <span class="truncate text-fg group-hover:text-accent">{post.data.permalink}.md</span>
              <span class="col-[-2/-1] truncate text-faint"># {post.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p id="blog-empty" class="text-muted" hidden>grep: no matches</p>

    <div class="mt-8" data-js-only>
      <label class="flex items-center gap-2">
        <span class="flex-none"><span class="text-accent">$</span> grep -i</span>
        <input
          id="blog-grep"
          type="search"
          placeholder="tag or title"
          class="min-w-0 flex-1 rounded border border-line bg-panel px-2 py-1 text-fg placeholder:text-faint focus-visible:border-accent"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
      <p class="mt-2 text-faint">
        # tags:{' '}
        {
          allTags.map((tag) => (
            <button type="button" class="mr-3 text-syn-str hover:underline" data-grep-tag={tag}>
              {tag}
            </button>
          ))
        }
      </p>
    </div>

    {
      page.lastPage > 1 && (
        <nav class="mt-8 flex flex-wrap items-center gap-4" aria-label="Pagination">
          <span class="text-muted">
            page {page.currentPage}/{page.lastPage}
          </span>
          {page.url.prev && <a href={page.url.prev} class="text-accent hover:underline">← newer</a>}
          {page.url.next && <a href={page.url.next} class="text-accent hover:underline">older →</a>}
        </nav>
      )
    }
  </section>
</Workspace>

<script>
  // `grep -i` over the listed posts: matches tags or title. Mirrors ?tag= for shareable links.
  document.addEventListener('astro:page-load', () => {
    const input = document.querySelector<HTMLInputElement>('#blog-grep');
    if (!input) return;
    const rows = document.querySelectorAll<HTMLElement>('#blog-list > li');
    const empty = document.querySelector<HTMLElement>('#blog-empty');

    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      rows.forEach((row) => {
        const match = !query || row.dataset.tags!.includes(query) || row.dataset.title!.includes(query);
        row.hidden = !match;
        if (match) visible++;
      });
      if (empty) empty.hidden = visible > 0;

      const url = new URL(window.location.href);
      if (query) url.searchParams.set('tag', input.value.trim());
      else url.searchParams.delete('tag');
      history.replaceState(history.state, '', url);
    };

    input.addEventListener('input', apply);
    document.querySelectorAll<HTMLElement>('[data-grep-tag]').forEach((button) =>
      button.addEventListener('click', () => {
        input.value = button.dataset.grepTag!;
        apply();
      })
    );

    const initial = new URLSearchParams(window.location.search).get('tag');
    if (initial) {
      input.value = initial;
      apply();
    }
  });
</script>

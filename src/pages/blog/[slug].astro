---
import Workspace from '../../layouts/Workspace.astro';
import { getCollection, render } from 'astro:content';
import { EMAIL } from '../../data/constants';
import { postFile } from '../../lib/workspace';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.permalink },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Get prev/next posts for navigation
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = sortedPosts.findIndex((p) => p.data.permalink === post.data.permalink);
const olderPost = sortedPosts[currentIndex + 1];
const newerPost = sortedPosts[currentIndex - 1];

const tags = post.data.tags ?? [];
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<Workspace
  file={postFile(post.data)}
  outline={headings}
  readingTime={post.data.readingTime}
  title={`${post.data.title} | Naofal Leo Agusta`}
  description={post.data.description}
  ogImage={post.data.ogImage?.src}
  canonical={`https://naofalleoagusta.xyz/blog/${post.data.permalink}`}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      author: {
        '@type': 'Person',
        name: 'Naofal Leo Agusta',
        url: 'https://naofalleoagusta.xyz',
      },
      publisher: {
        '@type': 'Person',
        name: 'Naofal Leo Agusta',
        url: 'https://naofalleoagusta.xyz',
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': `https://naofalleoagusta.xyz/blog/${post.data.permalink}`,
      },
      keywords: tags.join(', '),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://naofalleoagusta.xyz',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: 'https://naofalleoagusta.xyz/blog',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: post.data.title,
        },
      ],
    },
  ]}
>
  <article class="px-4 py-8 sm:px-10">
    <!-- Frontmatter, shown the way it sits at the top of the source file -->
    <div class="mb-8 max-w-[46rem] text-[0.8125rem] leading-6 text-muted" aria-label="Post details">
      <p class="text-faint">---</p>
      <p><span class="text-syn-key">date</span>: <time class="text-syn-num" datetime={post.data.date.toISOString()}>{isoDate(post.data.date)}</time></p>
      <p><span class="text-syn-key">readingTime</span>: <span class="text-syn-str">{post.data.readingTime}</span></p>
      {
        tags.length > 0 && (
          <p>
            <span class="text-syn-key">tags</span>: [{tags.map((tag, i) => (
              <>
                <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="text-syn-str hover:underline">{tag}</a>
                {i < tags.length - 1 && <span>, </span>}
              </>
            ))}]
          </p>
        )
      }
      <p class="text-faint">---</p>
    </div>

    <div class="preview preview--prose">
      <h1>{post.data.title}</h1>
      <Content />
    </div>

    <footer class="mt-14 max-w-[46rem] border-t border-dashed border-line pt-6 text-[0.8125rem]">
      <p class="text-muted">
        <span class="text-faint">// written by</span> Naofal Leo Agusta ·
        <a href={`mailto:${EMAIL}`} class="text-accent hover:underline">{EMAIL}</a>
      </p>

      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="More posts">
        {
          olderPost && (
            <a href={`/blog/${olderPost.data.permalink}`} class="group rounded border border-line p-3 hover:border-accent">
              <span class="block text-faint">← older</span>
              <span class="block truncate text-fg group-hover:text-accent">{olderPost.data.permalink}.md</span>
              <span class="block truncate text-muted">{olderPost.data.title}</span>
            </a>
          )
        }
        {
          newerPost && (
            <a
              href={`/blog/${newerPost.data.permalink}`}
              class="group rounded border border-line p-3 text-right hover:border-accent sm:col-start-2"
            >
              <span class="block text-faint">newer →</span>
              <span class="block truncate text-fg group-hover:text-accent">{newerPost.data.permalink}.md</span>
              <span class="block truncate text-muted">{newerPost.data.title}</span>
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</Workspace>

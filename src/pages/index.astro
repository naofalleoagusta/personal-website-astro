---
import { getCollection } from 'astro:content';
import Workspace from '../layouts/Workspace.astro';
import { README, RESUME, ABOUT, EXPERIENCE } from '../lib/workspace';
import { SOCIAL_LINKS, TECH_STACK } from '../data/constants';
import experiences from '../data/experiences.json';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// "Uptime" counts from the first job in experiences.json (oldest entry is last).
const [month, year] = experiences.at(-1)!.startDate.split(' ');
const careerStart = new Date(`${month} 1, ${year}`);
const years = Math.floor((Date.now() - careerStart.valueOf()) / (365.25 * 24 * 3600 * 1000));

const facts: [string, string][] = [
  ['Role', 'Software Engineer'],
  ['Host', experiences[0].name],
  ['Location', 'Palembang, Indonesia'],
  ['Uptime', `${years} years (since ${month.slice(0, 3)} ${year})`],
  ['Focus', 'Front-end, with full-stack experience'],
  ['Stack', TECH_STACK.join(', ')],
  ['Status', 'Open to remote roles'],
];

const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<Workspace file={README}>
  <article class="preview px-4 py-8 sm:px-10">
    <h1>Naofal Leo Agusta</h1>
    <p>
      Software engineer based in Palembang, Indonesia. A front-end developer with full-stack
      experience. My daily toolkit includes TypeScript, React, GraphQL, and Node.js. Currently
      building digital products at GovTech Procurement.
    </p>

    <section class="my-8 rounded border border-line bg-panel p-4 sm:p-5" aria-label="Profile">
      <p class="mb-1 font-bold">
        <span class="text-accent">naofal</span><span class="text-muted">@</span><span class="text-accent">palembang</span>
      </p>
      <p class="mb-3 text-faint" aria-hidden="true">─────────────────</p>
      <dl class="grid grid-cols-[9ch_1fr] gap-x-3 gap-y-0.5 text-[0.8125rem]">
        {
          facts.map(([label, value]) => (
            <>
              <dt class="font-bold text-syn-key">{label}</dt>
              <dd class="text-fg">{value}</dd>
            </>
          ))
        }
      </dl>
      <div class="mt-4 flex gap-0" aria-hidden="true">
        {['bg-bg', 'bg-accent', 'bg-syn-key', 'bg-syn-str', 'bg-syn-num', 'bg-syn-md', 'bg-syn-pdf', 'bg-fg'].map((c) => (
          <span class:list={['h-4 w-6', c]} />
        ))}
      </div>
    </section>

    <h2>Latest posts</h2>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.data.permalink}`}>{post.data.title}</a>
            <span class="text-faint"> · {isoDate(post.data.date)} · {post.data.readingTime}</span>
          </li>
        ))
      }
    </ul>
    <p><a href="/blog">ls blog/ →</a></p>

    <h2>Files</h2>
    <ul>
      <li><a href={ABOUT.href}>{ABOUT.name}</a> <span class="text-faint">— who I am</span></li>
      <li><a href={EXPERIENCE.href}>{EXPERIENCE.name}</a> <span class="text-faint">— where I've worked</span></li>
      <li>
        <a href={RESUME.href} target="_blank" rel="noopener noreferrer">{RESUME.name}</a>
        <span class="text-faint">— résumé (opens Google Drive)</span>
      </li>
    </ul>

    <h2>Links</h2>
    <ul>
      {
        SOCIAL_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-muted" data-js-only>
      <span class="text-accent">tip:</span> press <kbd class="text-fg" data-mod-key>⌘K</kbd> to open any file, or
      <kbd class="text-fg">Ctrl+`</kbd> for the terminal<span class="ws-cursor"></span>
    </p>
  </article>
</Workspace>

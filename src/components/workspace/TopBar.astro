---
import Icon from './Icon.astro';
import { ROOT_NAME } from '../../lib/workspace';

interface Props {
  fileName: string;
}

const { fileName } = Astro.props;
---

<header class="flex items-center gap-2 border-b border-line bg-panel px-2 text-[0.8125rem] text-muted">
  <a
    href="#explorer"
    class="flex size-8 items-center justify-center rounded hover:bg-hover hover:text-fg md:hidden"
    data-drawer-toggle
    aria-label="Open explorer"
    aria-controls="explorer"
  >
    <Icon name="menu" />
  </a>
  <a href="/" class="px-1 font-bold text-fg hover:text-accent">NLA<span class="text-accent">/~</span></a>

  <p class="min-w-0 flex-1 truncate text-center">
    <span class="text-fg">{fileName}</span>
    <span class="hidden sm:inline"> — {ROOT_NAME}</span>
  </p>

  <button
    type="button"
    class="flex h-6 items-center gap-2 rounded border border-line bg-bg px-2 text-xs hover:border-faint hover:text-fg"
    data-action="palette"
    data-js-only
    aria-label="Open command palette"
  >
    <Icon name="search" class="size-3.5" />
    <span class="hidden lg:inline">Search files</span>
    <kbd class="font-mono text-faint" data-mod-key>⌘K</kbd>
  </button>
</header>

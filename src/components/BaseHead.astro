---
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | ImageMetadata;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Naofal Leo Agusta | Software Engineer',
  description = 'Personal website and blog of Naofal Leo Agusta, a software engineer based in Palembang, Indonesia.',
  ogImage,
  canonical,
  jsonLd
} = Astro.props;

const defaultOgImage = '/images/og-default.png';
const ogImageSrc = typeof ogImage === 'string'
  ? ogImage
  : ogImage?.src ?? defaultOgImage;

const siteUrl = 'https://naofalleoagusta.xyz';
const fullOgImage = ogImageSrc.startsWith('http') ? ogImageSrc : `${siteUrl}${ogImageSrc}`;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Naofal Leo Agusta" />
<link rel="canonical" href={canonical || Astro.url.href} />

<meta name="theme-color" content="#141110" />

<!-- Favicon -->
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title="Naofal Leo Agusta" href="/rss.xml" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Naofal Leo Agusta" />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@naofalleoagusta" />
<meta name="twitter:creator" content="@naofalleoagusta" />
<meta property="twitter:url" content={Astro.url.href} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullOgImage} />

<!-- JSON-LD structured data -->
{jsonLd && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
)}

<!-- Without JS, hide the Workspace extras that need it (Tabs, Terminal, palette, theme switch) -->
<noscript><style>[data-js-only] { display: none !important; }</style></noscript>

<!-- Theme + Explorer state before first paint. Mirrors readTheme() in src/lib/theme.ts. -->
<script is:inline>
  (function () {
    const root = document.documentElement;
    try {
      let theme = localStorage.getItem('theme');
      if (theme === 'light') theme = 'ember-light';
      root.dataset.theme = theme === 'ember-light' ? 'ember-light' : 'ember-dark';
      if (localStorage.getItem('ws:explorer') === 'closed') root.dataset.explorer = 'closed';
    } catch {
      root.dataset.theme = 'ember-dark';
    }
  })();
</script>

<ClientRouter />
